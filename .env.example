# LOKI orchestration: LLM backend ("llamacpp" or "mlx")
LOKI_LLM_BACKEND=llamacpp
LOKI_MODEL_PATH=
LOKI_MLX_MODEL_PATH=
LOKI_MMPROJ_PATH=
LOKI_DRAFT_MODEL_PATH=
LOKI_LORA_PATH=
LOKI_TERSE_SYSTEM=0
LOKI_N_CTX=8192
LOKI_N_GPU_LAYERS=-1
LOKI_N_BATCH=512
LOKI_CHAT_FORMAT=auto
LOKI_PROMPT_CACHE_MB=512
# KV cache precision as a ggml type id: 8 = q8_0 (default), 1 = f16
LOKI_KV_TYPE=8
LOKI_MLOCK=1

# Speculative decoding: "prompt_lookup" (default, no extra model) | "draft_model" | "none"
LOKI_SPECULATIVE_MODE=prompt_lookup
LOKI_PROMPT_LOOKUP_NGRAM=2
LOKI_PROMPT_LOOKUP_NUM_PRED=10

# llmlingua-2 prompt compression for long page_text (0=off, 1=on)
LOKI_PROMPT_COMPRESSION=0

# TTS backend: "system" (macOS /usr/bin/say) | "kokoro" (Kokoro-82M 4-bit MLX)
LOKI_TTS_BACKEND=system

# Kokoro model directory (default: orchestration/weights/tts/kokoro-82m-4bit)
# LOKI_TTS_MODEL_PATH=

# macOS `say` fallback: voice name (default: best installed English voice) and words per minute
# LOKI_SYSTEM_TTS_VOICE=
LOKI_SYSTEM_TTS_RATE=185

# Moonshine STT: optional explicit model directory.
# When unset, models are resolved from the platform Moonshine cache
# (macOS: ~/Library/Caches/moonshine_voice/download.moonshine.ai/model/…).
# LOKI_STT_MODEL_PATH=
